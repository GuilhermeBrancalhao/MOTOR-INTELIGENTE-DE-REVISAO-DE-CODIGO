{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engine.sh\" --travar-sem-python \"${CLAUDE_PLUGIN_ROOT}/hooks/engine_risco.py\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engine.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/engine_trilha.py\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engine.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/engine_contexto.py\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engine.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/engine_salvar.py\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/engine.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/engine_gate.py\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
